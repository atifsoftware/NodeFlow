{
  "name": "nodeflow-framework",
  "version": "1.1.0",
  "description": "High-Performance, Developer-Friendly Express.js MVC Framework for Node.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "build:ts": "tsc",
    "dev:ts": "ts-node --require tsconfig-paths/register server.ts",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atifsoftware/NodeFlow.git"
  },
  "bugs": {
    "url": "https://github.com/atifsoftware/NodeFlow/issues"
  },
  "homepage": "https://github.com/atifsoftware/NodeFlow#readme",
  "keywords": [
    "express",
    "mvc",
    "framework",
    "laravel-like",
    "query-builder",
    "mysql",
    "ejs",
    "swagger",
    "websockets"
  ],
  "author": "Atif Software",
  "license": "MIT",
  "dependencies": {
    "@types/ioredis": "^4.28.10",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.0",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.9.7",
    "redis": "^6.2.0",
    "session-file-store": "^1.5.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/dotenv": "^6.1.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2"
  }
}
