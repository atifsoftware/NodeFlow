<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= typeof title !== 'undefined' ? title : settingsMap.name %></title>
  
  <!-- Favicon Icon -->
  <link rel="icon" type="image/png" href="/images/logo.png">
  
  <!-- Google Fonts ('Hind Siliguri' & 'Inter') -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS & FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Prism Syntax Highlighting -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css">

  <!-- Modern Stylings -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Alpine.js Core Script -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body>

  <!-- Premium Global Navbar -->
  <nav class="navbar navbar-expand-lg sticky-top" style="background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 0.8rem 0; z-index: 1000;">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="logo-group">
        <a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none;">
          <img src="/images/logo.png" alt="NodeFlow Logo" style="height: 42px; width: 42px; object-fit: cover; border-radius: 10px; box-shadow: 0 0 15px rgba(14, 165, 233, 0.4); border: 1px solid rgba(14, 165, 233, 0.3);">
          <div style="display: flex; flex-direction: column;">
            <span class="logo-text" style="font-weight: 800; font-size: 1.25rem; color: #f8fafc; font-family: 'Inter'; letter-spacing: -0.5px;">NodeFlow<span style="color: #0ea5e9;">.js</span></span>
            <span style="font-size: 0.68rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Express MVC Framework</span>
          </div>
        </a>
      </div>

      <!-- Navigation Links -->
      <div class="d-flex align-items-center gap-4">
        <a href="/docs" style="color: #cbd5e1; text-decoration: none; font-weight: 600; font-size: 0.95rem; font-family: 'Inter'; display: flex; align-items: center; gap: 6px; transition: color 0.2s;">
          <i class="fas fa-book-open" style="color: #0ea5e9;"></i> Documentation
        </a>
        <a href="/api/docs" target="_blank" style="color: #cbd5e1; text-decoration: none; font-weight: 600; font-size: 0.95rem; font-family: 'Inter'; display: flex; align-items: center; gap: 6px; transition: color 0.2s;">
          <i class="fas fa-code" style="color: #10b981;"></i> API Specs
        </a>

        <% if (user) { %>
          <div class="nav-user d-flex align-items-center gap-3">
            <a href="/admin/dashboard" class="btn btn-outline-light" style="padding: 0.4rem 1rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; border-color: rgba(255,255,255,0.15); font-family: 'Hind Siliguri';">
              <i class="fas fa-tachometer-alt me-1"></i> ড্যাশবোর্ড
            </a>
            <a href="/logout" class="btn btn-danger" style="padding: 0.4rem 1rem; font-size: 0.85rem; border-radius: 8px; font-family: 'Hind Siliguri'; background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">
              <i class="fas fa-sign-out-alt me-1"></i> লগআউট
            </a>
          </div>
        <% } else { %>
          <div class="nav-links d-flex align-items-center gap-2">
            <a href="/login" class="btn btn-primary" style="background: linear-gradient(135deg, #0ea5e9, #0284c7); border: none; padding: 0.45rem 1.35rem; border-radius: 10px; font-size: 0.88rem; font-weight: 700; font-family: 'Hind Siliguri'; box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);">
              <i class="fas fa-lock me-1"></i> লগইন
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container animate-fade-in" style="margin-top: 2rem;">
