    </div> <!-- End of .adm-page -->
</div> <!-- End of .adm-content -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Sidebar Toggle (Mobile view)
function toggleSidebar() {
    document.getElementById('admSidebar').classList.toggle('open');
    document.getElementById('admOverlay').classList.toggle('open');
}
function closeSidebar() {
    document.getElementById('admSidebar').classList.remove('open');
    document.getElementById('admOverlay').classList.remove('open');
}
</script>

<!-- Socket.io Client and Premium Floating Toast Notification Engine -->
<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        try {
            const socket = io();
            
            socket.on('notification', (data) => {
                showRealtimeNotification(data);
            });
            
            console.log('✓ Socket.io client-side receiver connected successfully.');
        } catch (e) {
            console.error('Socket.io connection failed:', e);
        }
    });

    function showRealtimeNotification(data) {
        const container = document.getElementById('toast-notification-container') || createToastContainer();
        
        const toast = document.createElement('div');
        toast.className = `alert alert-${data.type || 'info'} d-flex align-items-center gap-3`;
        toast.style.cssText = `
            margin-bottom: 0.85rem;
            border: 1px solid var(--border-color);
            background: var(--modal-bg);
            color: var(--text-main);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-radius: 16px;
            box-shadow: var(--shadow-premium);
            padding: 1rem 1.25rem;
            min-width: 320px;
            max-width: 420px;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            animation: slideInRight 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        `;

        const colors = {
            success: '#10b981',
            danger: '#f43f5e',
            info: '#0ea5e9',
            warning: '#f59e0b',
            secondary: '#94a3b8'
        };
        const accentColor = colors[data.type] || '#0ea5e9';
        toast.style.borderLeft = `5px solid ${accentColor}`;

        const icons = {
            success: 'fa-check-circle',
            danger: 'fa-exclamation-circle',
            info: 'fa-info-circle',
            warning: 'fa-exclamation-triangle',
            secondary: 'fa-history'
        };
        const iconName = icons[data.type] || 'fa-bell';

        toast.innerHTML = `
            <div class="avatar-premium" style="width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0; background: linear-gradient(135deg, ${accentColor} 0%, rgba(255,255,255,0.05) 100%); display: flex; align-items: center; justify-content: center;">
                <i class="fas ${iconName}" style="color: white; font-size: 0.95rem;"></i>
            </div>
            <div style="flex: 1;">
                <div class="fw-bold" style="font-size: 0.9rem; margin-bottom: 0.15rem; color: var(--text-main); font-family: 'Hind Siliguri';">${data.title}</div>
                <div class="text-muted" style="font-size: 0.8rem; font-family: 'Hind Siliguri'; line-height: 1.3;">${data.message}</div>
            </div>
            <button type="button" class="btn-close btn-close-premium" onclick="this.parentElement.remove()" style="margin: 0; padding: 0.4rem; font-size: 0.6rem; align-self: flex-start; filter: var(--close-btn-filter);"></button>
        `;

        container.appendChild(toast);

        // Auto remove toast after 6 seconds
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(100px)';
            setTimeout(() => toast.remove(), 400);
        }, 6000);
    }

    function createToastContainer() {
        const container = document.createElement('div');
        container.id = 'toast-notification-container';
        container.style.cssText = `
            position: fixed;
            top: 2rem;
            right: 2rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            pointer-events: none;
        `;
        
        container.addEventListener('click', (e) => {
            e.stopPropagation();
        });
        document.body.appendChild(container);
        
        const style = document.createElement('style');
        style.textContent = `
            @keyframes slideInRight {
                from { transform: translateX(120%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            #toast-notification-container > div {
                pointer-events: auto;
            }
        `;
        document.head.appendChild(style);

        return container;
    }
</script>
</body>
</html>
