</div>

<!-- Interactive Code & Architecture Showcase -->
<div class="row g-4 mb-5 align-items-stretch" x-data="{ tab: 'query' }">
    <div class="col-lg-5 d-flex flex-column justify-content-center">
        <div style="padding-right: 1.5rem;">
            <span style="color: #0ea5e9; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; display: block; margin-bottom: 0.75rem;">Developer Experience First</span>
            <h2 style="font-size: 2.2rem; font-weight: 800; color: #f8fafc; font-family: 'Inter', 'Hind Siliguri'; line-height: 1.25; margin-bottom: 1.2rem;">
                লারাভেলের মতো এলিগ্যান্ট কুয়েরি ও মডিউলার আর্কিটেকচার
            </h2>
            <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.7; font-family: 'Hind Siliguri'; margin-bottom: 1.8rem;">
                SQL-এর জটিলতা ভুলে সহজে চেইনেবল পদ্ধতি ব্যবহার করে ডেটাবেজ অপারেশন সামলান। Fluent Query Builder এবং Active Record ORM আপনার ডেটা অ্যাক্সেসকে করে তুলবে সুরক্ষিত ও সংক্ষিপ্ত।
            </p>

            <div class="d-flex flex-column gap-3">
                <button @click="tab = 'query'" :class="tab === 'query' ? 'btn-tab-active' : 'btn-tab'" class="btn text-start p-3 rounded-3 transition-all" style="border: 1px solid rgba(255,255,255,0.08); background: rgba(30,41,59,0.4); color: white;">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(14,165,233,0.15); display: flex; align-items: center; justify-content: center; color: #0ea5e9;"><i class="fas fa-database"></i></div>
                        <div>
                            <div style="font-weight: 700; font-size: 0.95rem;">Fluent Query Builder</div>
                            <div style="font-size: 0.8rem; color: #94a3b8;">Laravel Query Builder inspired syntax for MySQL</div>
                        </div>
                    </div>
                </button>

                <button @click="tab = 'model'" :class="tab === 'model' ? 'btn-tab-active' : 'btn-tab'" class="btn text-start p-3 rounded-3 transition-all" style="border: 1px solid rgba(255,255,255,0.08); background: rgba(30,41,59,0.4); color: white;">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(16,185,129,0.15); display: flex; align-items: center; justify-content: center; color: #10b981;"><i class="fas fa-cube"></i></div>
                        <div>
                            <div style="font-weight: 700; font-size: 0.95rem;">Active Record Model</div>
                            <div style="font-size: 0.8rem; color: #94a3b8;">Models with relationship mapping & auto password hashing</div>
                        </div>
                    </div>
                </button>

                <button @click="tab = 'cli'" :class="tab === 'cli' ? 'btn-tab-active' : 'btn-tab'" class="btn text-start p-3 rounded-3 transition-all" style="border: 1px solid rgba(255,255,255,0.08); background: rgba(30,41,59,0.4); color: white;">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(245,158,11,0.15); display: flex; align-items: center; justify-content: center; color: #f59e0b;"><i class="fas fa-terminal"></i></div>
                        <div>
                            <div style="font-weight: 700; font-size: 0.95rem;">CLI Code Generators</div>
                            <div style="font-size: 0.8rem; color: #94a3b8;">Artisan-like generator CLI tool (`node cli.js`)</div>
                        </div>
                    </div>
                </button>
            </div>
        </div>
    </div>

    <!-- Code Display Window -->
    <div class="col-lg-7">
        <div class="card h-100" style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 18px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.6);">
            <!-- Window Titlebar -->
            <div class="d-flex justify-content-between align-items-center px-4 py-3" style="background: rgba(30, 41, 59, 0.8); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                <div class="d-flex align-items-center gap-2">
                    <span style="width: 12px; height: 12px; border-radius: 50%; background: #ef4444; display: inline-block;"></span>
                    <span style="width: 12px; height: 12px; border-radius: 50%; background: #f59e0b; display: inline-block;"></span>
                    <span style="width: 12px; height: 12px; border-radius: 50%; background: #10b981; display: inline-block;"></span>
                </div>
                <span style="font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #94a3b8;" x-text="tab === 'query' ? 'config/db.js (QueryBuilder)' : (tab === 'model' ? 'app/models/User.js' : 'terminal CLI execution')"></span>
                <span class="badge bg-secondary opacity-75" style="font-family: 'Fira Code', monospace; font-size: 0.7rem;">NodeFlow v1.0</span>
            </div>

            <!-- Code Snippet Container -->
            <div class="p-3" style="font-family: 'Fira Code', monospace; font-size: 0.88rem; overflow-x: auto;">
                <!-- Tab 1: Query Builder -->
                <div x-show="tab === 'query'">
                    <pre class="m-0"><code class="language-javascript">const DB = require('./config/db');

// 1. Fluent Chainable Select Query
const activeUsers = await DB.table('users')
  .select(['id', 'name', 'email', 'role'])
  .where('status', 'active')
  .whereIn('role', ['admin', 'manager'])
  .orderBy('id', 'DESC')
  .limit(10)
  .get();

// 2. Database Transactions Support
await DB.transaction(async (trx) => {
  await trx.table('users').where('id', 1).update({ status: 'active' });
  await trx.table('activity_logs').insert({
    action: 'USER_ACTIVATED',
    description: 'Admin activated user account'
  });
});</code></pre>
                </div>

                <!-- Tab 2: Model -->
                <div x-show="tab === 'model'">
                    <pre class="m-0"><code class="language-javascript">const Model = require('../core/Model');

class User extends Model {
  static table = 'users';
  static primaryKey = 'id';
  static hidden = ['password']; // Hidden from JSON output

  // Custom static helper methods
  static async findByEmail(email) {
    return await this.query().where('email', email).first();
  }

  // Relations mapping
  tokens() {
    return this.hasMany(require('./PersonalAccessToken'), 'tokenable_id');
  }
}

module.exports = User;</code></pre>
                </div>

                <!-- Tab 3: CLI -->
                <div x-show="tab === 'cli'">
                    <pre class="m-0"><code class="language-bash"># NodeFlow Artisan Generator CLI Usage
$ node cli.js make:controller ProductController
✔ Controller created successfully at app/controllers/ProductController.js

$ node cli.js make:model Product
✔ Model created successfully at app/models/Product.js

$ node cli.js make:migration create_products_table
✔ Migration created successfully at database/migrations/create_products_table.js

$ node cli.js migrate
✔ All pending database migrations executed successfully!</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

