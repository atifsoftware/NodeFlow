    <div style="position: absolute; width: 450px; height: 450px; background: rgba(16, 185, 129, 0.18); filter: blur(120px); bottom: -100px; right: 15%; border-radius: 50%; pointer-events: none;"></div>

    <div style="position: relative; z-index: 10; max-width: 900px; margin: 0 auto;">
