            <a href="/api/docs" target="_blank" class="btn btn-outline-light" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.15); color: #f8fafc; font-weight: 600; padding: 0.9rem 2.2rem; border-radius: 14px; font-size: 1rem; font-family: 'Inter', 'Hind Siliguri'; display: inline-flex; align-items: center; gap: 10px; backdrop-filter: blur(8px);">
                <i class="fas fa-code"></i> API Specs Explore
