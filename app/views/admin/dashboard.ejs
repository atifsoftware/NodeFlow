<%- include('../layouts/admin_header') %>

<div class="row g-4 mb-4">
    <!-- Users widget -->
    <div class="col-md-4">
        <div class="card p-4" style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="color: var(--text-secondary); margin: 0; font-family: 'Hind Siliguri'; font-weight: 600;">মোট ব্যবহারকারী</h5>
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(14, 165, 233, 0.1); color: #0ea5e9; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;"><i class="fas fa-users"></i></div>
            </div>
            <h2 style="color: white; font-weight: 800; font-family: 'Inter'; margin: 0;"><%= stats.usersCount %></h2>
            <p style="color: var(--text-muted); font-size: 0.8rem; margin: 5px 0 0 0; font-family: 'Hind Siliguri';">সিস্টেমে নিবন্ধিত মোট অ্যাকাউন্টস</p>
        </div>
    </div>

    <!-- API Tokens widget -->
    <div class="col-md-4">
        <div class="card p-4" style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="color: var(--text-secondary); margin: 0; font-family: 'Hind Siliguri'; font-weight: 600;">সক্রিয় এপিআই টোকেন</h5>
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(16, 185, 129, 0.1); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;"><i class="fas fa-key"></i></div>
            </div>
            <h2 style="color: white; font-weight: 800; font-family: 'Inter'; margin: 0;"><%= stats.tokensCount %></h2>
            <p style="color: var(--text-muted); font-size: 0.8rem; margin: 5px 0 0 0; font-family: 'Hind Siliguri';">ব্যক্তিগত অ্যাক্সেস টোকেন সংখ্যা</p>
        </div>
    </div>

    <!-- Logs widget -->
    <div class="col-md-4">
        <div class="card p-4" style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="color: var(--text-secondary); margin: 0; font-family: 'Hind Siliguri'; font-weight: 600;">মোট সিস্টেম লগস</h5>
                <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(245, 158, 11, 0.1); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;"><i class="fas fa-history"></i></div>
            </div>
            <h2 style="color: white; font-weight: 800; font-family: 'Inter'; margin: 0;"><%= stats.logsCount %></h2>
            <p style="color: var(--text-muted); font-size: 0.8rem; margin: 5px 0 0 0; font-family: 'Hind Siliguri';">মোট সংরক্ষিত ইউজার অ্যাক্টিভিটি</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Server stats -->
    <div class="col-md-6">
        <div class="card p-4" style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px; height: 100%;">
            <h4 style="color: #0ea5e9; font-weight: 700; font-size: 1.25rem; font-family: 'Hind Siliguri'; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.75rem; margin-bottom: 1.5rem;"><i class="fas fa-server me-2"></i> সার্ভার এনভায়রনমেন্ট ডায়াগনস্টিক</h4>
            
            <table class="table table-borderless table-sm" style="color: #cbd5e1; font-size: 0.95rem; margin: 0;">
                <tbody>
                    <tr>
                        <td style="padding: 0.5rem 0; font-family: 'Hind Siliguri'; font-weight: 600; color: #94a3b8; width: 40%;">অপারেটিং সিস্টেম</td>
                        <td style="padding: 0.5rem 0; color: white;"><%= stats.osType %> (<%= stats.osRelease %>)</td>
                    </tr>
                    <tr>
                        <td style="padding: 0.5rem 0; font-family: 'Hind Siliguri'; font-weight: 600; color: #94a3b8;">সিপিইউ মডেল</td>
                        <td style="padding: 0.5rem 0; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 250px;" title="<%= stats.cpuModel %>"><%= stats.cpuModel %></td>
                    </tr>
                    <tr>
                        <td style="padding: 0.5rem 0; font-family: 'Hind Siliguri'; font-weight: 600; color: #94a3b8;">সিপিইউ কোর সংখ্যা</td>
                        <td style="padding: 0.5rem 0; color: white;"><%= stats.cpuCores %> Cores</td>
                    </tr>
                    <tr>
                        <td style="padding: 0.5rem 0; font-family: 'Hind Siliguri'; font-weight: 600; color: #94a3b8;">সার্ভার মেমরি ব্যবহার</td>
                        <td style="padding: 0.5rem 0; color: white;"><%= stats.memoryUsage %></td>
                    </tr>
                    <tr>
                        <td style="padding: 0.5rem 0; font-family: 'Hind Siliguri'; font-weight: 600; color: #94a3b8;">সার্ভার আপটাইম</td>
                        <td style="padding: 0.5rem 0; color: white;"><%= stats.uptime %></td>
                    </tr>
                    <tr>
                        <td style="padding: 0.5rem 0; font-family: 'Hind Siliguri'; font-weight: 600; color: #94a3b8;">Node.js ভার্সন</td>
                        <td style="padding: 0.5rem 0; color: white; font-family: 'Inter'; font-weight: 600;"><%= stats.nodeVersion %></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent logs -->
    <div class="col-md-6">
        <div class="card p-4" style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px; height: 100%;">
            <h4 style="color: #10b981; font-weight: 700; font-size: 1.25rem; font-family: 'Hind Siliguri'; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.75rem; margin-bottom: 1.5rem;"><i class="fas fa-list-ul me-2"></i> সাম্প্রতিক অ্যাক্টিভিটি লগস</h4>
            
            <% if (logs.length === 0) { %>
                <div class="text-center text-muted py-4" style="font-family: 'Hind Siliguri';">কোনো অ্যাক্টিভিটি লগ পাওয়া যায়নি।</div>
            <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    <% logs.forEach(log => { %>
                        <div class="p-3" style="background: rgba(15, 23, 42, 0.3); border: 1px solid rgba(255,255,255,0.03); border-radius: 10px;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong style="color: white; font-size: 0.9rem; font-family: 'Hind Siliguri';"><%= log.user_name %></strong>
                                <small style="color: #94a3b8; font-size: 0.75rem;"><%= new Date(log.created_at).toLocaleString() %></small>
                            </div>
                            <div style="color: #cbd5e1; font-size: 0.85rem; font-family: 'Hind Siliguri';"><%= log.action %> — <%= log.description %></div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../layouts/admin_footer') %>
